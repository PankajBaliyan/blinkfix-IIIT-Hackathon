# Blinkfix / Swarm Zero Environment Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Cerebras Cloud API (Ultra-low latency LLM inference)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# How much the model thinks before answering: low, medium or high (low is fastest)
CEREBRAS_REASONING_EFFORT=low
# Requests per minute your key allows (free keys are around 5), and how long a call may wait for a slot
CEREBRAS_MAX_RPM=5
CEREBRAS_MAX_WAIT_S=10
# batched = the five agents share one model call; parallel = one call per agent (needs a higher limit)
CEREBRAS_AGENT_MODE=batched

# GitHub API Integration (for automated PR creation)
GITHUB_OWNER=PankajBaliyan
GITHUB_REPO=blinkfix-IIIT-Hackathon

# Slack Webhook (for incident alerts)
SLACK_WEBHOOK_URL=

# SQLite Database File Path
DATABASE_PATH=data/blinkfix.db


# --- GitHub: repository Blinkfix reads and opens pull requests against
GITHUB_BASE_BRANCH=main
# Open a draft pull request automatically once a fix is verified (true/false)
AUTO_OPEN_PR=true
GITHUB_PATH_PREFIX=server/
# OAuth App credentials (GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL must be: http://localhost:8000/api/github/callback
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
# public_repo is enough for a public repository. Use "repo" if the repository is private.
GITHUB_OAUTH_SCOPE=public_repo
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
FRONTEND_URL=http://localhost:5173

# --- OpenAI (Codex coding agent)
OPENAI_API_KEY=sk-...
CODEX_MODEL=  # run: curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
