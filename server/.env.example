# Blinkfix / Swarm Zero Environment Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Cerebras Cloud API (Ultra-low latency LLM inference)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b

# Codex generates complete checkout candidate files via the Responses API.
OPENAI_API_KEY=
CODEX_MODEL=gpt-5.3-codex

# GitHub API Integration (for automated PR creation)
GITHUB_TOKEN=
GITHUB_OWNER=swarm-zero-demo
GITHUB_REPO=checkout-service
GITHUB_TARGET_FILE=payments.cjs

# Slack Webhook (for incident alerts)
SLACK_WEBHOOK_URL=

# SQLite Database File Path
DATABASE_PATH=data/blinkfix.db

# Execution mode is explicit per API request (live or fixture).
# Missing credentials fail live runs. Fixture runs execute tests but never publish.

